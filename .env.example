# Copy to .env for local work. Never commit .env. No real secrets in this file.
DJANGO_SETTINGS_MODULE=payroll_project.settings.development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Production only (settings.production)
DJANGO_CSRF_TRUSTED_ORIGINS=https://hr.example.com

# Production PostgreSQL database
# For Vercel deployment, use your Supabase PostgreSQL connection string.
DATABASE_URL=

# ... or the separate values:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
DB_DISABLE_SERVER_SIDE_CURSORS=False
DJANGO_LOG_LEVEL=INFO


# Email (password reset). Production needs a real SMTP server.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=HROS <hr@example.com>

# Attendance
DJANGO_CORRECTION_WINDOW_DAYS=30

# Sessions and sign-in protection
DJANGO_SESSION_IDLE_MINUTES=60
DJANGO_PASSWORD_RESET_MINUTES=60
DJANGO_LOGIN_MAX_FAILURES=5
DJANGO_LOGIN_FAILURE_WINDOW_MINUTES=15
DJANGO_TRUST_X_FORWARDED_FOR=False

# Production security (see settings/production.py for explanations)
DJANGO_SSL_REDIRECT=True
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Google OAuth — configure actual values in your local .env or Vercel environment
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=