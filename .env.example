# Copy to .env for local work. Never commit .env. No real secrets in this file.
DJANGO_SETTINGS_MODULE=payroll_project.settings.development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Production only (settings.production)
DJANGO_CSRF_TRUSTED_ORIGINS=https://hr.example.com
# Either a single URL (Neon, Supabase, Render...) ...
DATABASE_URL=
# ... or the separate values:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
DB_DISABLE_SERVER_SIDE_CURSORS=False
DJANGO_LOG_LEVEL=INFO

# Production security (see settings/production.py for explanations)
DJANGO_SSL_REDIRECT=True
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
